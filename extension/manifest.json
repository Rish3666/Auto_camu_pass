{
  "manifest_version": 3,
  "name": "Auto Camu Pass",
  "version": "0.1.6",
  "version_name": "0.1.6 (Beta 1.6)",
  "description": "Automatically submits your Camu gate pass every Thursday and Friday between 09:00 and 23:00.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://student.camu.in/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Auto Camu Pass"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://student.camu.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
