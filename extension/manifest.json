{
  "manifest_version": 3,
  "name": "Auto Camu Pass",
  "version": "1.0.0",
  "version_name": "1.0.0-alpha.1",
  "description": "Automatically submits your Camu gate pass every Tuesday between 09:00 and 23:00.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://student.camu.in/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Auto Camu Pass"
  },
  "background": {
    "service_worker": "background.js"
  }
}
