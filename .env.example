# Copy this file to .env (never commit .env!) and fill in your values.
# Generate CAMU_SECRET_KEY with: python crypto_helper.py keygen

TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
CAMU_SECRET_KEY=replace-with-fernet-key-from-crypto_helper

# Optional: Scheduled IST run time (24h format, defaults to 10:00 IST on Thu & Fri)
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0

# Optional: SQLite database path (mount a persistent volume in Docker)
DB_PATH=data/users.db
